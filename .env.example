# ── App ─────────────────────────────────────────────────────
# Production (Vercel): set NEXTAUTH_URL=https://calendula-herbs.com in Vercel dashboard
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_ME_generate_with_openssl_rand_base64_32

# ── Database (Supabase) ──────────────────────────────────────
# Find in: Supabase → Project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Cloudinary ──────────────────────────────────────────────
# Find in: Cloudinary → Dashboard
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_ME

# ── Resend (Transactional Email) ─────────────────────────────
# Find in: Resend → API Keys
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=noreply@calendula-herbs.com

# ── Upstash Redis (Rate Limiting) ────────────────────────────
# Find in: Upstash → Redis → REST API
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ── Admin Bootstrap (seeding only) ───────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_KEY=see_secrets.json

# ── OpenRouter (Free AI Image Generation) ────────────────────
# Get free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=REPLACE_ME_openrouter_api_key

# ── Alternatively: Puter.js (Free AI, no API key) ────────────
# Create Puter account at: https://puter.com, get token from account settings
PUTER_AUTH_TOKEN=REPLACE_ME_optional

# ── Africa's Talking (SMS OTP - optional) ────────────────────
AT_API_KEY=REPLACE_ME_optional
AT_USERNAME=REPLACE_ME_optional

# ── Public Variables (safe to expose) ────────────────────────
NEXT_PUBLIC_SITE_URL=https://calendula-herbs.com
NEXT_PUBLIC_APP_URL=https://calendula-herbs.com
NEXT_PUBLIC_COMPANY_NAME=Calendula Herbs For Import & Export
NEXT_PUBLIC_COMPANY_LINKEDIN=https://eg.linkedin.com/company/calendula-herbs-import-export

# ── Sentry (Error Monitoring) ────────────────────────────────
# DSN is public-safe — embed in both NEXT_PUBLIC and server env
NEXT_PUBLIC_SENTRY_DSN=https://27a7b9577764600f09945cc2fe66b2ea7@o4518243603087836.ingest.de.sentry.io/4518243670845456
SENTRY_DSN=https://27a7b9577764600f09945cc2fe66b2ea7@o4518243603087836.ingest.de.sentry.io/4518243670845456
SENTRY_ORG=calendula-herbs-spices-for-exp
SENTRY_PROJECT=calendula-herbs
# Get from: sentry.io → Settings → Auth Tokens → Create New Token (scope: project:releases, org:read)
SENTRY_AUTH_TOKEN=REPLACE_ME_keep_secret_never_commit

# ============================================================
# SEARCH ENGINE WEBMASTER VERIFICATION
# ============================================================
# All values are meta-tag content strings (NOT full <meta> tags).
# Set in Vercel → Project Settings → Environment Variables (Production).
# Never commit actual verification codes to git.
#
# ── Google Search Console ────────────────────────────────────
# Path: search.google.com/search-console → Add property → HTML tag method
# Copy only the content="…" value (e.g. "abc123XYZ")
GOOGLE_SITE_VERIFICATION=

# ── Bing Webmaster Tools ─────────────────────────────────────
# Path: bing.com/webmasters → Add site → HTML meta tag
# Copy only the content="…" value
BING_SITE_VERIFICATION=

# ── Yandex Webmaster ─────────────────────────────────────────
# Path: webmaster.yandex.com → Add site → HTML meta tag
# Copy only the content="…" value
YANDEX_VERIFICATION=

# ── Baidu Ziyuan (百度站长平台) ─────────────────────────────
# Path: ziyuan.baidu.com → Site management → Verification → Meta tag
# Copy only the content="…" value
BAIDU_SITE_VERIFICATION=

# ── Naver Search Advisor (South Korea) ──────────────────────
# Path: searchadvisor.naver.com → Web master tool → Site list → Verification
# Copy only the content="…" value
NAVER_SITE_VERIFICATION=

# ── 360 Search / Haosou (China) ─────────────────────────────
# Path: zhanzhang.so.com → Site management → Verification → Meta tag
# Copy only the content="…" value
HAOSOU_SITE_VERIFICATION=

# ── Sogou Webmaster (China) ──────────────────────────────────
# Path: zhanzhang.sogou.com → Site management → Verification → Meta tag
# Copy only the content="…" value
SOGOU_SITE_VERIFICATION=

# ── Seznam Webmaster (Czechia) ───────────────────────────────
# Path: napoveda.seznam.cz/en/fulltext-search/webmaster-tools/ → Verification
# Copy only the content="…" value
SEZNAM_SITE_VERIFICATION=

# ── Pinterest Domain Verification ────────────────────────────
# Path: pinterest.com/settings/claim-website → Verify with HTML meta tag
# Copy only the content="…" value (improves Rich Pin discovery)
PINTEREST_SITE_VERIFICATION=
